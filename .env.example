# Home Assistant base URL. Use your local, VPN, or container-network URL.
HA_URL=https://home-assistant.example.com

# Home Assistant long-lived access token. Never commit real tokens.
HA_TOKEN=replace-with-home-assistant-token

# Optional: request timeout for Home Assistant REST calls.
HA_REQUEST_TIMEOUT_MS=10000

# Optional: mark fields stale when Home Assistant timestamps are older than this many hours.
HA_STALE_AFTER_HOURS=24
