{
  "name": "homeassistant-garmin-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing Garmin-derived Home Assistant stats.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhchein/homeassistant-garmin-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/jhchein/homeassistant-garmin-mcp/issues"
  },
  "homepage": "https://github.com/jhchein/homeassistant-garmin-mcp#readme",
  "keywords": [
    "garmin",
    "home-assistant",
    "mcp",
    "model-context-protocol"
  ],
  "packageManager": "npm@11.12.1",
  "bin": {
    "homeassistant-garmin-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "docs/development.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "smoke": "tsx scripts/smoke-current-stats.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint . && markdownlint-cli2 \"**/*.md\" \"!node_modules/**\" \"!dist/**\" \"!coverage/**\"",
    "lint:fix": "biome check --write . && markdownlint-cli2 --fix \"**/*.md\" \"!node_modules/**\" \"!dist/**\" \"!coverage/**\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^4.1.8",
    "markdownlint-cli2": "^0.22.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
